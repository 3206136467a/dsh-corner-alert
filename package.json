{
  "name": "dsh-corner-alert",
  "version": "1.1.0",
  "private": false,
  "description": "Turn-complete and needs-user-action alerts plus a hot-restart chip for the DeepSeek Harness Web GUI: bottom-right toast, system notification sound.",
  "license": "MIT",
  "author": "dsh-corner-alert contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3206136467a/dsh-corner-alert.git"
  },
  "homepage": "https://github.com/3206136467a/dsh-corner-alert#readme",
  "bugs": {
    "url": "https://github.com/3206136467a/dsh-corner-alert/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "notification",
    "toast",
    "hot-restart"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "install.ps1",
    "install.sh",
    "README.md",
    "README.en.md",
    "DISCLAIMER.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "id": "dsh-corner-alert",
    "name": "Corner Alert",
    "version": "1.1.0",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
